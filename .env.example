# Garba Night · IIMA — server settings. Copy to .env (start.sh does this for you) and fill in.
# The app never sends email: sign-in is Google (or Microsoft) only.

# ---- Where it runs ----
# Public URL of the app (no trailing slash). Used in pass links and the Google redirect.
APP_URL=https://students.iima.ac.in/garba2026
# Sub-path Apache forwards to this server (must match APP_URL's path).
BASE_PATH=/garba2026/
# Port Apache proxies to.
PORT=8090
# Address to listen on. 127.0.0.1 when Apache is on this machine; 0.0.0.0 when Apache
# runs on another server (then point its ProxyPass at http://<this-server-ip>:PORT/).
HOST=127.0.0.1
# Where the database and backups live. Back this folder up.
DATA_DIR=./data
# Apache sends the real visitor IP in this header.
TRUSTED_PROXY_HEADERS=X-Forwarded-For

# ---- Who gets in ----
# Anyone signing in with an email on these domains gets a pass automatically.
MEMBER_DOMAINS=iima.ac.in
# These people are always Cultcomm admins (comma separated).
ADMIN_EMAILS=

# ---- Google sign-in (required) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI:  https://students.iima.ac.in/garba2026/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft sign-in (optional, for exchange colleges whose mail is on Microsoft 365, e.g. MICA) ----
# entra.microsoft.com → App registrations → New registration
#   Supported account types: Any Entra ID tenant (multitenant, NOT personal accounts)
#   Redirect URI (Web):      https://students.iima.ac.in/garba2026/auth/callback
# Anyone signing in still needs a pass on the exchange list for their college email.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: one college's domain (e.g. micamail.in) to accept only that organisation. Empty = any college.
MICROSOFT_TENANT=

# ---- PocketBase dashboard login (optional) ----
# If set, start.sh creates/updates this superuser. Dashboard: https://students.iima.ac.in/garba2026/_/
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
