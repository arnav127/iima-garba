# Copy to /opt/garba/garba.env and fill in. Loaded by deploy/garba.service.

# Public URL of the web app. Used in claim links and emails.
# Campus-only: the server's URL. With Vercel: the Vercel URL (e.g. https://iima-garba.vercel.app).
APP_URL=https://garba.iima.ac.in

# These people are always Cultcomm admins (comma separated). They can import the list from the app.
ADMIN_EMAILS=cultcomm@iima.ac.in

# Google sign-in. Create an OAuth client (Web application) in Google Cloud Console and add
# <APP_URL>/auth/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for sign-in codes and "you've been sent a pass" mails.
# Gmail/Workspace: smtp.gmail.com, port 587, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=0
MAIL_FROM_ADDRESS=cultcomm@iima.ac.in
MAIL_FROM_NAME=Cultcomm IIMA
