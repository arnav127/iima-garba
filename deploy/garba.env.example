# Copy to /opt/garba/garba.env and fill in. Loaded by deploy/garba.service.
# The app never sends email: sign-in is Google (or Microsoft) only.

# Public URL of the web app. Used in pass links.
# Campus-only: the server's URL. With Vercel: the Vercel URL (e.g. https://iima-garba.vercel.app).
APP_URL=https://garba.iima.ac.in

# Anyone signing in with an email on these domains gets a pass automatically.
MEMBER_DOMAINS=iima.ac.in

# These people are always Cultcomm admins (comma separated).
ADMIN_EMAILS=cultcomm@iima.ac.in

# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continue with Microsoft", in case @iima.ac.in accounts are on Microsoft 365.
# Azure portal → App registrations → redirect URI <APP_URL>/auth/callback (Web).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
